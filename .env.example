# Copy to .env.local for local experiments. Production values live in
# Vercel → Settings → Environment Variables. Do not commit real secrets.

# ── Buyer (All Clean Sol) ──────────────────────────────────────────────────
# Lead alerts (SMS + email) and the dashboard. Confirmed destination:
BUYER_NAME="All Clean Sol"
BUYER_EMAIL=contact@allcleansol.com
BUYER_PHONE=+17409712907
# Long random string — signs /dashboard links. Generate; do not reuse.
BUYER_SECRET=
# Bump to revoke every outstanding dashboard link.
BUYER_ACCESS_NONCE=v1
# Optional: extra addresses (comma-separated) that may sign in to /dashboard.
# BUYER_EMAIL and OWNER_EMAIL always can.
# DASHBOARD_EMAILS=

# ── GoHighLevel ────────────────────────────────────────────────────────────
GHL_PIT=
# Sub-account (North Columbus Cleaning)
GHL_LOCATION_ID=XIA5AmegWaylDoPVe3r8
# Public click-to-call (GHL LC / customer line). Homeowners dial this.
# After-Hours Call Routing already Connect-Calls TO BUYER_PHONE.
TRACKING_NUMBER=+16143522588
GHL_FROM_NUMBER=+16143522588
# Optional. If set, the GHL workflow webhook must send X-Webhook-Secret.
GHL_CALL_WEBHOOK_SECRET=
# If 1, skip inbound-call payloads that have no connected/answered signal.
# GHL_CALL_REQUIRE_ANSWERED=1
# Optional minimum connected seconds (default 0).
# GHL_CALL_MIN_DURATION=0

# ── Pricing ────────────────────────────────────────────────────────────────
LEAD_PRICING_MODE=per_lead
LEAD_PRICE=35
LEAD_FLAT_MONTHLY=200
LEAD_MONTHLY_INCLUDED=10
LEAD_DEDUPE_DAYS=30

# ── App ────────────────────────────────────────────────────────────────────
SITE_BASE_URL=https://www.northcolumbuscleaning.com
ADMIN_TOKEN=
# Monday weekly digest (13:00 UTC). Both addresses get their own To: copy.
# Also gets a copy of every website form lead (not phone calls).
OWNER_EMAIL=devyn@localseobot.com
# Optional comma-list override. OWNER_EMAIL + BUYER_EMAIL work without this.
# DIGEST_EMAILS=devyn@localseobot.com,contact@allcleansol.com
RESEND_API_KEY=
RESEND_FROM=
CRON_SECRET=
